# LLM 配置（OpenAI 兼容接口，DeepSeek / Claude / OpenAI 均兼容同一格式）
# 注意：BASE_URL 必须以 /v1 结尾（chat/completions 会拼在后面），否则真实调用会 404。
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 服务端口
PORT=3001

# 离线 mock：设为 1 时不发真实请求，返回假回答（用于无网络/无 key 联调）。
# 置空或 0 走真实 LLM（需可用的 OPENAI_BASE_URL + OPENAI_API_KEY）。
MOCK_LLM=0
